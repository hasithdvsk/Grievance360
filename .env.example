# Grievance360 - Centralized AI-Powered Grievance Redressal System
# Root Environment Variables Configuration

# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:postgres_secret_password@localhost:5432/grievance360_db

# Redis Cache & Message Broker
REDIS_URL=redis://localhost:6379/0

# Public Frontend API Target
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend Service Configuration
API_PORT=8000
API_HOST=0.0.0.0
DEBUG=True
SECRET_KEY=change-me-in-production-super-secret-key-360

# Celery Worker Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
